--- a/src/northbridge/intel/sandybridge/early_init.c
+++ b/src/northbridge/intel/sandybridge/early_init.c
@@ -8,6 +8,8 @@
 #include <option.h>
 #include <types.h>
 
+#include <arch/pci_io_cfg.h>
+#include <delay.h>
 #include "sandybridge.h"
 
 static void systemagent_vtd_init(void)
@@ -131,6 +133,18 @@ static void start_peg_link_training(void)
 		return;
 
 	deven = pci_read_config32(HOST_BRIDGE, DEVEN);
+	const unsigned int peg_mode = get_uint_option("peg_bifurcation", 0);
+	u32 deven_mask = 0;
+
+	if (peg_mode < 1)
+		deven_mask |= DEVEN_PEG11;
+	if (peg_mode < 2)
+		deven_mask |= DEVEN_PEG12;
+	if (deven & deven_mask) {
+		deven &= ~deven_mask;
+		pci_write_config32(HOST_BRIDGE, DEVEN, deven);
+	}
+	printk(BIOS_INFO, "PEG: mode=%u DEVEN=0x%08x\n", peg_mode, deven);
 
 	/*
 	 * For each PEG device, set bit 5 to use three retries for OC (Offset Calibration).
@@ -180,8 +194,32 @@ void systemagent_early_init(void)
 	systemagent_vtd_init();
 
 	/* Device Enable, don't touch PEG bits */
+	const u32 deven_before = pci_read_config32(HOST_BRIDGE, DEVEN);
 	pci_or_config32(HOST_BRIDGE, DEVEN, DEVEN_IGD);
 
+	/* H61M-S1+ IGD bring-up diagnostics */
+	printk(BIOS_DEBUG, "SA: CAPID0_A=%08x CAPID0_B=%08x DEVEN_pre=%08x DEVEN_post=%08x GGC=%04x\n",
+	       pci_read_config32(HOST_BRIDGE, CAPID0_A),
+	       pci_read_config32(HOST_BRIDGE, CAPID0_B),
+	       deven_before,
+	       pci_read_config32(HOST_BRIDGE, DEVEN),
+	       pci_read_config16(HOST_BRIDGE, GGC));
+	printk(BIOS_DEBUG, "SA: IGD 00:02.0 MMCONF=%08x CF8=%08x (host DID=%04x)\n",
+	       pci_read_config32(PCI_DEV(0, 2, 0), PCI_VENDOR_ID),
+	       pci_io_read_config32(PCI_DEV(0, 2, 0), PCI_VENDOR_ID),
+	       pci_read_config16(HOST_BRIDGE, PCI_DEVICE_ID));
+
+	if (pci_read_config16(PCI_DEV(0, 2, 0), PCI_VENDOR_ID) == 0xffff) {
+		/* Give Device 2 time to come out of reset, then try again. */
+		mdelay(20);
+		pci_or_config32(HOST_BRIDGE, DEVEN, DEVEN_IGD);
+		mdelay(20);
+		printk(BIOS_DEBUG, "SA: IGD retry: DEVEN=%08x MMCONF=%08x CF8=%08x\n",
+		       pci_read_config32(HOST_BRIDGE, DEVEN),
+		       pci_read_config32(PCI_DEV(0, 2, 0), PCI_VENDOR_ID),
+		       pci_io_read_config32(PCI_DEV(0, 2, 0), PCI_VENDOR_ID));
+	}
+
 	sandybridge_setup_graphics();
 
 	/*
