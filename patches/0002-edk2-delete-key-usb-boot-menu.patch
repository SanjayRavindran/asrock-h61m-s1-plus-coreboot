+STATIC
+EFI_STATUS
+PlatformRegisterUsbBootMenuOption (
+  OUT UINT16  *OptionNumber
+  )
+{
+  EFI_STATUS                         Status;
+  UINTN                              Index;
+  BOOLEAN                            ExactMatch;
+  EFI_BOOT_MANAGER_LOAD_OPTION       NewOption;
+  EFI_BOOT_MANAGER_LOAD_OPTION       *BootOptions;
+  UINTN                              BootOptionCount;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  FileNode;
+  EFI_DEVICE_PATH_PROTOCOL           *DevicePath;
+  EFI_DEVICE_PATH_PROTOCOL           *FvDevicePath;
+  CHAR16                             *OptData;
+
+  if (OptionNumber == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  FvDevicePath = BdsGetFvFileDevicePath (&mUsbBootMenuFileGuid);
+  if (FvDevicePath == NULL) {
+    return EFI_NOT_FOUND;
+  }
+
+  EfiInitializeFwVolDevicepathNode (&FileNode, &mUsbBootMenuFileGuid);
+  DevicePath = AppendDevicePathNode (
+                 FvDevicePath,
+                 (EFI_DEVICE_PATH_PROTOCOL *)&FileNode
+                 );
+  FreePool (FvDevicePath);
+  if (DevicePath == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  OptData = L"USB_ONLY";
+  Status  = EfiBootManagerInitializeLoadOption (
+              &NewOption,
+              LoadOptionNumberUnassigned,
+              LoadOptionTypeBoot,
+              LOAD_OPTION_ACTIVE | LOAD_OPTION_HIDDEN | LOAD_OPTION_CATEGORY_APP,
+              L"USB Boot Menu",
+              DevicePath,
+              (UINT8 *)OptData,
+              (UINT32)StrSize (OptData)
+              );
+  FreePool (DevicePath);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  BootOptions   = EfiBootManagerGetLoadOptions (&BootOptionCount, LoadOptionTypeBoot);
+  ExactMatch    = FALSE;
+  *OptionNumber = (UINT16)LoadOptionNumberUnassigned;
+
+  for (Index = 0; Index < BootOptionCount; Index++) {
+    if (!BootOptionReferencesFvFileGuid (&BootOptions[Index], &mUsbBootMenuFileGuid)) {
+      continue;
+    }
+
+    if (PlatformFindLoadOption (&NewOption, &BootOptions[Index], 1) != -1) {
+      ExactMatch    = TRUE;
+      *OptionNumber = (UINT16)BootOptions[Index].OptionNumber;
+      continue;
+    }
+
+    EfiBootManagerDeleteLoadOptionVariable (
+      BootOptions[Index].OptionNumber,
+      LoadOptionTypeBoot
+      );
+  }
+
+  if (!ExactMatch) {
+    Status = EfiBootManagerAddLoadOptionVariable (&NewOption, (UINTN)-1);
+    if (!EFI_ERROR (Status)) {
+      *OptionNumber = (UINT16)NewOption.OptionNumber;
+    }
+  } else {
+    Status = EFI_SUCCESS;
+  }
+
+  EfiBootManagerFreeLoadOption (&NewOption);
+  EfiBootManagerFreeLoadOptions (BootOptions, BootOptionCount);
+  return Status;
+}
