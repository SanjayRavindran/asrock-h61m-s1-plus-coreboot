+STATIC EFI_GUID mUsbBootMenuFileGuid = {
+  0xeec25bdc, 0x67f2, 0x4d95, { 0xb1, 0xd5, 0xf8, 0x1b, 0x20, 0x39, 0xd1, 0x1d }
+};
