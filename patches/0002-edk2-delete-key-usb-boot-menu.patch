+STATIC
+BOOLEAN
+IsUsbDevicePath (
+  IN EFI_DEVICE_PATH_PROTOCOL  *DevicePath
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+
+  if (DevicePath == NULL) {
+    return FALSE;
+  }
+
+  for (Node = DevicePath; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+    if ((DevicePathType (Node) == MESSAGING_DEVICE_PATH) &&
+        ((DevicePathSubType (Node) == MSG_USB_DP) ||
+         (DevicePathSubType (Node) == MSG_USB_CLASS_DP) ||
+         (DevicePathSubType (Node) == MSG_USB_WWID_DP)))
+    {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+STATIC
+HARDDRIVE_DEVICE_PATH *
+FindHardDriveNode (
+  IN EFI_DEVICE_PATH_PROTOCOL  *DevicePath
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+
+  if (DevicePath == NULL) {
+    return NULL;
+  }
+
+  for (Node = DevicePath; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+    if ((DevicePathType (Node) == MEDIA_DEVICE_PATH) &&
+        (DevicePathSubType (Node) == MEDIA_HARDDRIVE_DP))
+    {
+      return (HARDDRIVE_DEVICE_PATH *)Node;
+    }
+  }
+
+  return NULL;
+}
+
+STATIC
+BOOLEAN
+IsUsbBootOption (
+  IN EFI_BOOT_MANAGER_LOAD_OPTION  *BootOption
+  )
+{
+  EFI_STATUS                Status;
+  UINTN                     HandleCount;
+  EFI_HANDLE                *HandleBuffer;
+  UINTN                     Index;
+  EFI_DEVICE_PATH_PROTOCOL  *HandleDp;
+  HARDDRIVE_DEVICE_PATH     *OptHd;
+  HARDDRIVE_DEVICE_PATH     *HandleHd;
+
+  if ((BootOption == NULL) || (BootOption->FilePath == NULL)) {
+    return FALSE;
+  }
+
+  if (IsUsbDevicePath (BootOption->FilePath)) {
+    return TRUE;
+  }
+
+  OptHd = FindHardDriveNode (BootOption->FilePath);
+  if (OptHd == NULL) {
+    return FALSE;
+  }
+
+  HandleCount  = 0;
+  HandleBuffer = NULL;
+  Status       = gBS->LocateHandleBuffer (
+                        ByProtocol,
+                        &gEfiBlockIoProtocolGuid,
+                        NULL,
+                        &HandleCount,
+                        &HandleBuffer
+                        );
+  if (EFI_ERROR (Status) || (HandleBuffer == NULL)) {
+    return FALSE;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (
+                    HandleBuffer[Index],
+                    &gEfiDevicePathProtocolGuid,
+                    (VOID **)&HandleDp
+                    );
+    if (EFI_ERROR (Status) || !IsUsbDevicePath (HandleDp)) {
+      continue;
+    }
+
+    HandleHd = FindHardDriveNode (HandleDp);
+    if ((HandleHd != NULL) &&
+        (HandleHd->PartitionNumber == OptHd->PartitionNumber) &&
+        (HandleHd->MBRType == OptHd->MBRType) &&
+        (HandleHd->SignatureType == OptHd->SignatureType) &&
+        (CompareMem (HandleHd->Signature, OptHd->Signature, sizeof (HandleHd->Signature)) == 0))
+    {
+      FreePool (HandleBuffer);
+      return TRUE;
+    }
+  }
+
+  FreePool (HandleBuffer);
+  return FALSE;
+}
